# =============================================================================
# Frontend environment variables (Vite)
# =============================================================================
# Copy to frontend/.env.local if you want overrides.
# In Vite, only variables starting with VITE_ are visible to the browser.
# Never put secret API keys here — Gemini keys belong in the root .env only.
# =============================================================================

# Local development: point at Django, OR leave empty and use the Vite /api proxy.
VITE_DJANGO_API_URL=http://127.0.0.1:8000

# Public Vercel site: do NOT set this for local day-to-day work.
# scripts/update-snapshot.sh sets VITE_STATIC_SNAPSHOT=true for the committed
# snapshot/ build. That build serves Analysis journey JSON only (no live API).
# VITE_STATIC_SNAPSHOT=true
