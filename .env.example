# =============================================================================
# Environment variables (TEMPLATE)
# =============================================================================
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#      Example (in Terminal, from the project root):
#        cp .env.example .env
#   2. Paste your real API keys into .env (replace the placeholder text).
#   3. Never commit .env — it is listed in .gitignore on purpose.
# =============================================================================

# --- Google Gemini (used by the FastAPI AI service) --------------------------
# Get a key from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to use (safe default below)
GEMINI_MODEL=gemini-2.0-flash

# --- Django backend ----------------------------------------------------------
# Generate a new secret for production. For local dev, any long random string works.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Service URLs (local development defaults) -------------------------------
# These are for local fullstack work only. The public Vercel site does NOT
# host Django/AI — it serves the committed static folder snapshot/ instead.
# (Docs convenience; frontend uses VITE_DJANGO_API_URL or the Vite /api proxy.)
DJANGO_API_URL=http://127.0.0.1:8000
AI_SERVICE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5173

# --- CORS (comma-separated origins allowed to call the APIs) -----------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- NYC Open Data / Socrata (SODA) ------------------------------------------
# Dataset page: https://data.cityofnewyork.us/Housing-Development/Open-HPD-Violations/csn4-vhvf
# Query endpoint (SODA3): https://data.cityofnewyork.us/api/v3/views/csn4-vhvf/query.json
# Create an app token: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_DOMAIN=data.cityofnewyork.us
SOCRATA_DATASET_ID=csn4-vhvf
SOCRATA_APP_TOKEN=your_socrata_app_token_here

# Optional — only needed if you create/update/delete rows on Socrata
SOCRATA_USERNAME=
SOCRATA_PASSWORD=

# How long (seconds) to wait for a single SODA HTTP request
SOCRATA_TIMEOUT=300

# Page size when downloading past the default 1000-row cap (NYC often allows 50000)
SOCRATA_PAGE_SIZE=50000
